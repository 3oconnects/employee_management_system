# Database Connection (Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Project URL
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server Configuration
PORT=4000
NODE_ENV=development
# Required, no defaults. The server refuses to start unless both are set to different random
# values of at least 32 characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_URL=http://localhost:5173

# Error monitoring (optional; Release 0 B0-04). Leave SENTRY_DSN empty to disable.
# The client uses VITE_SENTRY_DSN at *build* time (see docs/runbooks/monitoring.md).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# Tracing is off by default (URLs may carry tokens until W-6). Set e.g. 0.1 to enable.
# SENTRY_TRACES_SAMPLE_RATE=0
