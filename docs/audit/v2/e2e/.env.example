# Copy values into the shell environment (never commit real values).
# API and client MUST be loopback; helpers/env.ts refuses anything else.
E2E_API_URL=http://localhost:4000/api/v1
# The server CORS allow-list only admits :5173/:3000 on localhost, so the client must run on 5173.
E2E_CLIENT_URL=http://localhost:5173
# Same value that was passed as STAGING_SEED_PASSWORD to server/scripts/staging/rebuild.ts (>= 12 chars).
E2E_SEED_PASSWORD=
# Seeded users are <key>@ems-staging.example.test (admin, hr, manager, employee, super_admin, custom)
E2E_EMAIL_DOMAIN=ems-staging.example.test
